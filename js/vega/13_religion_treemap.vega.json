{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Treemap (built with Vega): religious affiliation reported in the 2021 Census. Rectangles are grouped into Christianity, other religions, no religion and not stated; area is proportional to the number of people.",
  "signals": [
    {
      "name": "width",
      "init": "max(320, min(560, containerSize()[0]))",
      "on": [{"events": "window:resize", "update": "max(320, min(560, containerSize()[0]))"}]
    }
  ],
  "height": 340,
  "padding": 0,
  "autosize": "none",
  "data": [
    {
      "name": "religion",
      "url": "data/religion_2021.csv",
      "format": {"type": "csv", "parse": {"persons": "number"}},
      "transform": [
        {"type": "joinaggregate", "ops": ["sum"], "fields": ["persons"], "as": ["total"]},
        {"type": "formula", "expr": "datum.persons / datum.total * 100", "as": "share"}
      ]
    },
    {
      "name": "tree",
      "source": "religion",
      "transform": [
        {"type": "nest", "keys": ["group"], "generate": true},
        {
          "type": "treemap",
          "field": "persons",
          "sort": {"field": "value", "order": "descending"},
          "round": true,
          "method": "squarify",
          "ratio": 1.4,
          "paddingInner": 3,
          "size": [{"signal": "width"}, {"signal": "height"}]
        }
      ]
    },
    {"name": "leaves", "source": "tree", "transform": [{"type": "filter", "expr": "!datum.children"}]}
  ],
  "scales": [
    {
      "name": "colour",
      "type": "ordinal",
      "domain": ["Christianity", "Other religions", "No religion", "Not stated"],
      "range": ["#2a78d6", "#1a9e8a", "#a04c96", "#b9b2a6"]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {"data": "leaves"},
      "encode": {
        "enter": {
          "fill": {"scale": "colour", "field": "group"},
          "stroke": {"value": "#fbf8f3"},
          "strokeWidth": {"value": 1},
          "tooltip": {
            "signal": "{'Religion': datum.religion, 'Group': datum.group, 'People': format(datum.persons, ','), 'Share of population': format(datum.share, '.1f') + '%'}"
          }
        },
        "update": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"},
          "fillOpacity": {"value": 0.9}
        },
        "hover": {"fillOpacity": {"value": 1}}
      }
    },
    {
      "type": "text",
      "from": {"data": "leaves"},
      "interactive": false,
      "encode": {
        "enter": {
          "baseline": {"value": "top"},
          "fill": {"value": "#ffffff"},
          "font": {"value": "Source Sans 3, Segoe UI, Helvetica, Arial, sans-serif"},
          "fontSize": {"value": 12.5},
          "fontWeight": {"value": 700},
          "lineHeight": {"value": 15}
        },
        "update": {
          "x": {"signal": "datum.x0 + 7"},
          "y": {"signal": "datum.y0 + 7"},
          "text": {
            "signal": "(datum.x1 - datum.x0) > length(datum.religion) * 6.3 + 12 && (datum.y1 - datum.y0) > 40 ? [datum.religion, format(datum.share, '.1f') + '%'] : (datum.x1 - datum.x0) > 40 && (datum.y1 - datum.y0) > 22 ? format(datum.share, '.0f') + '%' : ''"
          }
        }
      }
    }
  ]
}
